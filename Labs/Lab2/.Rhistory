streams <- st_transform(streams, st_crs(counties))# set counties to same crs as streams
streams_counties <- st_intersection(streams, counties)
stream_length <- st_length(streams_counties)
streams_counties <- streams_counties %>%
mutate(stream_length) %>%
group_by(COUNTYFP10)
View(streams_counties)
Try1 <- streams_counties %>%
summarize(Tot_Strm_Length = sum(stream_length))
Try1 <- streams_counties %>%
summarize(Tot_Strm_Length = sum(stream_length, na.rm =T))
streams_counties <- streams_counties %>%
mutate(stream_length) %>%
group_by(COUNTYFP10) %>%
st_drop_geometry()
Try1 <- streams_counties %>%
summarize(Tot_Strm_Length = sum(stream_length))
View(Try1)
