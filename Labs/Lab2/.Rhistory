# setup
library(tidyverse)
library(sf)
library(tmap)
# spatial
# Note, the st_make_valid() calls are NOT necessary in all cases
# But we know it's needed for the counties, and doesn't really hurt anything
# for the others
counties <- sf::read_sf("./CBW/County_Boundaries.shp") %>%
sf::st_make_valid()
dams <- sf::read_sf("./CBW/Dam_or_Other_Blockage_Removed_2012_2017.shp") %>%
sf::st_make_valid()
streams <- sf::read_sf("./CBW/Streams_Opened_by_Dam_Removal_2012_2017.shp") %>%
sf::st_make_valid()
# aspatial
bmps <- read_csv("./CBW/BMPreport2016_landbmps.csv")
bmps %>%
group_by(StateAbbreviation) %>% # Group to make statistics for each states
summarize(.,
Min = min(Cost, na.rm = T),
Q1 = quantile(Cost, 0.25, na.rm = T),
Mean = mean(Cost, na.rm = T),
Med = median(Cost, na.rm = T),
Q3 = quantile(Cost, .75, na.rm = T),
Max = max(Cost, na.rm = T), # Summarize different statistics for each group, leave out null values
)
library(scales) # Found this package so that I can remove the scientific notion on the plot axis
bmps %>%
filter(., Unit == 'Acres') %>% # Only get Bmps with unit of acres
filter(., Cost <= 7500000) %>% # Limit the cost slightly to reduce skewing
ggplot(., aes(x = Cost, y = TotalAmountCredited)) +
geom_point() +
scale_x_continuous(labels = comma) + # removes sci not. and adds commas instead
scale_y_continuous(labels = comma) +
theme_bw() +
labs(title = 'Cost vs amount credited for BMPs',
subtitle = '(Unit type of acres only)',
x = "Cost",
y = 'Total Amount Credited')
library(stringr)
bmps %>%
filter(str_detect(BMP, 'Cover Crop')) %>% # detects all the values in BMP that contain cover crop
filter(., TotalAmountCredited > 1 & TotalAmountCredited < 100) %>% # filter to remove some skewing
ggplot(., aes(x = StateAbbreviation, y = TotalAmountCredited)) + # plot the data as a boxplot
geom_boxplot(aes(fill = StateAbbreviation)) +
theme_bw() +
guides(fill = FALSE) +
labs(title = 'Total amount credited for cover crop BMPs by state',
x = "State",
y = 'Total Amount Credited')
dams %>%
filter(., YEAR > 0) %>% # Remove data points with year 0
ggplot(., aes(x = YEAR, y = STATE)) + # make a scatterplot
geom_point(size = 3, color = 'blue') +
theme_bw() +
labs(title = 'Cost vs amount credited for BMPs',
subtitle = '(Unit type of acres only)',
x = "Year Built",
y = 'State')
bmps <- bmps %>% mutate(., FIPS.trimmed = stringr::str_sub(GeographyName, 1, 5)) # Change FIPS for joining
counties_bmps <- full_join(bmps, counties, by = c('FIPS.trimmed'="GEOID10")) # join datasets by geoid
counties_bmps %>%
filter(NAME10 == 'Lebanon') %>% # filter to one county
count(BMPType, BMPShortName) %>% # count BMPS in county
ggplot(., aes(x = BMPShortName, y = BMPType, size = n, color = n)) +
geom_point(alpha = 0.7) +  # make bubbles/points and set transparency
scale_size(range = c(1, 6)) +  # bubble size
scale_color_viridis_c() + # color pallete
theme_minimal() +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1), #set text sizes and change the x axis to vertical
axis.text.y = element_text(vjust = 0.5, hjust = 1)
) +
labs(size = "Count", color = "Count", x = "BMP", y = "BMP Type", title = "BMP Occurances in Lebanon County, PA") # labels
# (Not super legible but I thought it was interesting)
stream_length <- streams %>% st_length() # find stream length as a list
streams %>%
mutate(stream_length) %>% # make a new column in streams df using stream_length list
sort_by(desc(stream_length)) %>% # sort descending length
select(OBJECTID_1,GNIS_Name,stream_length) %>% # select only needed columns
head(5)
streams <- st_transform(streams, st_crs(counties))# set counties to same crs as streams
streams_counties <- st_intersection(streams, counties) # Join by intersection
stream_length <- st_length(streams_counties) # calculate stream lengths
streams_counties %>%
mutate(stream_length) %>% # add stream length as a column
group_by(COUNTYFP10) %>%
st_drop_geometry() %>%
summarize(Tot_Strm_Length = sum(stream_length)) %>% # create new column with total stream length per county
slice_max(Tot_Strm_Length, n = 3) # get top three counties
bmps1 <- bmps %>%
mutate(., FIPS.trimmed = stringr::str_sub(GeographyName, 1, 5)) %>% # shorten to easier fips
group_by(FIPS.trimmed) %>%
summarize(Total_Cost = sum(Cost, na.rm = T)) # find total cost per county
County_BMP <- counties %>%
left_join(bmps1, by = c("GEOID10" = "FIPS.trimmed")) # join counties df and bmp df to get the total cost column
tm_shape(County_BMP) + tm_polygons(fill = "Total_Cost") # simple mapping
streams <- st_transform(streams, st_crs(dams))# set streams to same crs as dams
nearest_streams <- st_nearest_feature(dams, streams)
# returns a list: one number for each dam
# Each number is the row of the closest river in the rivers df
dams_closest_stream <- cbind(dams, streams[nearest_streams, c("GNIS_Name", "OBJECTID_1")]) %>%
select("DAM_NAME","GNIS_Name","OBJECTID_1.1")
# creates new columns in dams <- go into streams DF and [select all the rows listed in nearest_streams, (retrieve the specific columns)]
# Select the columns that answer the questions
head(dams_closest_stream)
counties <- st_transform(counties, st_crs(dams))# set streams to same crs as dams
dams_counties <- st_join(dams, counties) # spatially join dams and counties
dams_counties %>%
group_by(STATEFP10) %>% # group by state
summarize(Dams_Removed = n()) # count occurrence of each state in the dams list
dams %>%
filter(., YEAR > 0) %>% # Remove data points with year 0
ggplot(., aes(x = YEAR, y = STATE)) + # make a scatterplot
geom_point(size = 3, color = 'blue') +
theme_bw() +
labs(title = 'Year of dam construction by state',
x = "Year Built",
y = 'State')
