States <- c(39, 26, 18, 55, 17) # States FIPS I want
# Subset of states
d.Midwest <- sf::read_sf("./data/ACS_2020_5YR_COUNTY.gdb", layer = "ACS_2020_5YR_COUNTY") %>%
filter(STATEFP %in% States)
# Save new states file for GitHub upload
st_write(d.Midwest,"D:/EnvAnalysisR/GEOG49073/Labs/Lab3/data/d.Midwest/d.Midwest.shp")
d.Midwest <- st_read("./data/d.Midwest.shp")
d.Midwest <- st_read("./data/d.Midwest")
d.x8 <- read_csv("./data/x08_Commuting.csv")
# Note
# B08006e20 = SEX OF WORKERS BY MEANS OF TRANSPORTATION TO WORK: Car, truck, or van: Drove alone: Workers 16 years and over -- (Estimate)
# B08006e1 = SEX OF WORKERS BY MEANS OF TRANSPORTATION TO WORK: Total: Workers 16 years and over -- (Estimate)
d.Midwest <- st_read("./data/d.Midwest")
d.x8 <- read_csv("./data/x08_Commuting.csv")
# Table I want - GEOID needs fixed to match counties
d.x8 <- d.x8 %>%
mutate(fixed_geoid = str_sub(GEOID, start = 8, end = -1))
# Join data
JoinedData <- d.Midwest %>% left_join(., d.x8, by = c("GEOID" = "fixed_geoid"))
JoinedData <- JoinedData %>%
select(STATEFP, COUNTYF, GEOID, NAME, TOT_POP = B08006e1, Drove_Alone = B08006e20) %>%
mutate(PntPersonalCom = (Drove_Alone/TOT_POP)*100) # Make a new column of percent of people who commute alone with a personal vehicle
hist(JoinedData$PntPersonalCom)
ggplot(JoinedData) +
geom_sf(aes(fill = PntPersonalCom)) +
scale_fill_viridis_b() +
theme_minimal() +
labs(title = "Percent of Workers Commuting with Personal Vehicles",
fill = "Percent of Total Workers")
# Re-project to north american equidistant conic
JoinedData.projected <- JoinedData %>% sf::st_transform(., "ESRI:102010")
# make the neighborhood
nb <- spdep::poly2nb(JoinedData.projected, queen = TRUE)
# Assign weights using style W
lw <- nb2listw(nb, style="W", zero.policy=TRUE)
# Find the count of neighbors in the dataset
neighbors <- attr(lw$weights,"comp")$d
# Plot it
hist(neighbors)
mean(neighbors)
moran.plot(JoinedData.projected$PntPersonalCom, lw, zero.policy=TRUE, plot=TRUE)
# Make sure polygons are in right projection
JoinedData.projected <- JoinedData %>% sf::st_transform(., "ESRI:102010")
# Get the centroid of the counties - get the coords - & turn it into a DF
coords <- data.frame(st_coordinates(st_centroid(st_geometry(JoinedData.projected))))
# Convert the coords into a sf class so that it can be used in the nb2listwdist function
SF_coords <- st_as_sf(coords, coords = c("X", "Y"), crs = 102010) #
# make the neighborhood
nb_IDW <- spdep::poly2nb(JoinedData.projected, queen = TRUE)
# Assign weights using style W and IDW
lw_IDW <- nb2listwdist(neighbours = nb_IDW, x = SF_coords, type = 'idw', style = 'W', zero.policy=TRUE)
# Find the count of neighbors in the dataset
neighbors_IDW <- attr(lw_IDW$weights,"comp")$d
# Plot amount of neighbors
hist(neighbors_IDW)
mean(neighbors_IDW)
moran.plot(JoinedData.projected$PntPersonalCom, lw_IDW, zero.policy=TRUE, plot=TRUE)
