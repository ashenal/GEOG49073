# Pull in redlining data and filter out unnecessary data
Redlining <- read_sf("./Data/mappinginequality.gpkg") %>%
filter(city == "Cleveland") %>%
filter(fill != "#000000") %>%
st_transform("EPSG:4326")
# Redlining map
RedliningMap <- tm_shape(Redlining) + tm_borders(col = "fill", lwd = 1.8) +  tm_shape(Cuyahoga_County) + tm_borders()
# Redlining map
RedliningMap <- tm_shape(Redlining) + tm_borders(col = "fill", lwd = 1.8) +  tm_shape(Cuyahoga_County) + tm_borders()
# Pull in redlining data and filter out unnecessary data
Redlining <- read_sf("./Data/mappinginequality.gpkg") %>%
filter(city == "Cleveland") %>%
filter(fill != "#000000") %>%
st_transform("EPSG:4326")
# Cuyahoga county boundary
Cuyahoga_County <- read_sf("./Data/Cuyahoga_Boundary/OH_County_Boundary_ExportFeatures.shp") %>%
st_transform("EPSG:4326")
# Redlining map
RedliningMap <- tm_shape(Redlining) + tm_borders(col = "fill", lwd = 1.8) +  tm_shape(Cuyahoga_County) + tm_borders()
# Pull and clip tree cover raster
treecover <- terra::rast("./Data/raster.tiff") %>%
project("EPSG:4326") %>%
crop(Cuyahoga_County) %>%
mask(Cuyahoga_County)
# Tree cover map
TreeCover <- tm_shape(treecover) +
tm_raster(
palette = "Greens",
title = "Percent Tree Cover")
# Pull maps together and add a title
TreeCover + RedliningMap + tm_title(text = "Cuyahoga County Redlining & Tree Coverage")
library(grid)
library(terra)
library(sf)
library(tidyverse)
library(tmap)
# Load data and set crs
counties <- read_sf("./static_mapping/oh_counties.gpkg") %>%
st_transform("EPSG:4326")
oh2020 <- read_csv("./static_mapping/oh_counties_DP2020.csv")
portage_summit <- filter(counties, NAME %in% c("Summit", "Portage"))
joined.ohio.counties <- left_join(counties, oh2020, by=c("GEOIDFQ"="geoid")) # Join csv and counties
# Make box for the needed counties (important for later)
oh_region = st_bbox(portage_summit) %>%
st_as_sfc()
# Make the map
Ohio_Map <- tm_shape(joined.ohio.counties) + tm_polygons(
fill = 'medianage',
lty = 2,
fill.scale = tm_scale_intervals(style = 'jenks', values = "BuGn"),
fill.legend = tm_legend(title = "Median Age")) +
tm_shape(oh_region) + tm_borders(lwd = 3, col = "black") +
tm_layout(bg.color = "lightyellow") +
tm_scalebar(
breaks = c(0, 50, 100),
text.size = .8,
position = c("left", "top"))
Ohio_Map
# LOCAL SCALE MAPPING
# Load data and set crs
parks <- read_sf("./static_mapping/oh_parks.gpkg") %>%
st_transform("EPSG:4326")
streams <- read_sf("./static_mapping/oh_rivers.gpkg") %>%
st_transform("EPSG:4326")
places <- read_sf("./static_mapping/oh_places.gpkg") %>%
st_transform("EPSG:4326")
sf::sf_use_s2(FALSE)
# Select only necessary parks + streams in Portage and Summit
parks_sp <- st_intersection(parks, portage_summit)
streams_sp <- st_intersection(streams, portage_summit)
places_sp <- st_intersection(places, portage_summit)
# Make layers then combine into single map
streammap <- tm_shape(streams_sp) + tm_lines(lwd = 4, col = "darkblue")
boundary <- tm_shape(portage_summit) + tm_polygons()
parkmap <- tm_shape(parks_sp) + tm_polygons(fill = "FEATTYPE", palette = "greens", title = "Park Type")
placesmap <- tm_shape(places_sp) + tm_borders() + tm_shape(places_sp) #+ tm_text("NAME", size = 0.5)
placesmap
Local_Map <- boundary + parkmap + streammap + placesmap +  tm_layout(bg.color = "lightyellow")
Local_Map
# PUTTING IT TOGETHER
# Add the DEM, set crs, then clip
neoh_dem <- terra::rast("./static_mapping/neoh_dem.tif") %>%
project("EPSG:4326") %>%
crop(portage_summit) %>%
mask(portage_summit)
# Pull contents into a map for Summit and Portage County
map1 <- tm_shape(neoh_dem) + tm_raster(style = "cont", palette = c("lightblue", "darkblue"), alpha = 0.8, title = "Elevation (m)") +
tm_compass(position = c("right", "bottom")) +
tm_shape(parks_sp) + tm_polygons(fill = "FEATTYPE", palette = "greens", title = "Park Type") +
tm_shape(portage_summit) + tm_polygons(fill_alpha = 0.2) +
tm_shape(streams_sp) + tm_lines(lwd = 3, col = "darkblue") +
tm_shape(places_sp) + tm_borders() +
tm_layout(bg.color = "lightyellow", legend.outside = TRUE, legend.outside.position = "left") +
tm_title(text = "Portage and Summit County, Ohio")
# Change the ohio map so that it can be put together - remove the legend
Ohio_Map2 <- tm_shape(joined.ohio.counties) + tm_polygons(
fill = 'medianage',
lty = 2,
fill.scale = tm_scale_intervals(style = 'jenks', values = "BuGn"),
fill.legend = tm_legend(title = "Median Age")) +
tm_shape(oh_region) + tm_borders(lwd = 3, col = "black") +
tm_layout(bg.color = "lightyellow", legend.show = FALSE) +
tm_scalebar(
breaks = c(0, 50, 100),
text.size = .8,
position = c("left", "top"))
# Inset mapping
norm_dim = function(obj){
bbox = st_bbox(obj)
width = bbox[["xmax"]] - bbox[["xmin"]]
height = bbox[["ymax"]] - bbox[["ymin"]]
w = width / max(width, height)
h = height / max(width, height)
return(unit(c(w, h), "snpc"))}
main_dim = norm_dim(oh_region)
ins_dim = norm_dim(portage_summit)
main_vp = viewport(width = main_dim[1], height = main_dim[2])
ins_vp = viewport(width = ins_dim[1] * 0.6, height = ins_dim[2] * 0.6,
x = unit(1.0, "npc") - unit(0.3, "cm"), y = unit(-0.16, "npc"),
just = c("right", "bottom"))
grid.newpage()
pushViewport(main_vp)
print(map1, newpage = FALSE)
print(Ohio_Map2, vp = ins_vp, newpage = FALSE)
# Pull in redlining data and filter out unnecessary data
Redlining <- read_sf("./Data/mappinginequality.gpkg") %>%
filter(city == "Cleveland") %>%
filter(fill != "#000000") %>%
st_transform("EPSG:4326")
# Cuyahoga county boundary
Cuyahoga_County <- read_sf("./Data/Cuyahoga_Boundary/OH_County_Boundary_ExportFeatures.shp") %>%
st_transform("EPSG:4326")
# Redlining map
RedliningMap <- tm_shape(Redlining) + tm_borders(col = "fill", lwd = 1.8) +  tm_shape(Cuyahoga_County) + tm_borders()
# Pull and clip tree cover raster
treecover <- terra::rast("./Data/raster.tiff") %>%
project("EPSG:4326") %>%
crop(Cuyahoga_County) %>%
mask(Cuyahoga_County)
# Tree cover map
TreeCover <- tm_shape(treecover) +
tm_raster(
palette = "Greens",
title = "Percent Tree Cover")
# Pull maps together and add a title
TreeCover + RedliningMap + tm_title(text = "Cuyahoga County Redlining & Tree Coverage")
