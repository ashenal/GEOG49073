d.Midwest <- st_read("./data/d.Midwest")
# Pull in and GEOID needs fixed to match counties
d.x8 <- read_csv("./data/x08_Commuting.csv") %>%
mutate(fixed_geoid = str_sub(GEOID, start = 8, end = -1))
# Join data
JoinedData <- d.Midwest %>% left_join(., d.x8, by = c("GEOID" = "fixed_geoid"))
JoinedData <- JoinedData %>%
select(STATEFP, COUNTYF, GEOID, NAME, TOT_POP = B08006e1, Drove_Alone = B08006e20) %>%  # Select the needed columns
mutate(PntPersonalCom = (Drove_Alone/TOT_POP)*100) %>%  # new column: % of people who commute with a personal vehicle
st_transform(., "EPSG:4326")
# make the neighborhood
nb <- spdep::poly2nb(JoinedData, queen = TRUE)
# Assign weights using style W
lw <- nb2listw(nb, style="W", zero.policy=TRUE)
################
localmoran <-localmoran(JoinedData$PntPersonalCom, lw, zero.policy = TRUE)
Lag <- lag.listw(lw, JoinedData$PntPersonalCom, zero.policy = TRUE)
# Add local Moran's I results to your spatial dataframe
JoinedData$P.Ii <- localmoran[, "Pr(z != E(Ii))"]
JoinedData$PntPersonalCom_lag <- Lag
# Standardize the variables
JoinedData$PntPersonalCom_std <- scale(JoinedData$PntPersonalCom)
JoinedData$PntPersonalCom_lag_std <- scale(JoinedData$PntPersonalCom_lag)
# Classify observations into LISA clusters
JoinedData$lisa_cluster <- case_when(
JoinedData$PntPersonalCom_std > 0 &
JoinedData$PntPersonalCom_lag_std > 0 &
JoinedData$P.Ii <= 0.05 ~ "High-High",
JoinedData$PntPersonalCom_std < 0 &
JoinedData$PntPersonalCom_lag_std < 0 &
JoinedData$P.Ii <= 0.05 ~ "Low-Low",
JoinedData$PntPersonalCom_std < 0 &
JoinedData$PntPersonalCom_lag_std > 0 &
JoinedData$P.Ii <= 0.05 ~ "Low-High",
JoinedData$PntPersonalCom_std > 0 &
JoinedData$PntPersonalCom_lag_std < 0 &
JoinedData$P.Ii <= 0.05 ~ "High-Low",
TRUE ~ "Not significant")
pal <- c("High-High" = "red",
"Low-Low" = "blue",
"Low-High" = "lightblue",
"High-Low" = "pink",
"Not significant" = "white")
pal_lisa <- colorFactor(palette = pal, domain = JoinedData$lisa_cluster)
###############
Task_2 <- leaflet() %>%
addTiles() %>%
addPolygons(
data = JoinedData,
fillColor = ~pal_lisa(lisa_cluster),
stroke = TRUE,
color = 'black',
fillOpacity = 1,
weight = 2,
popup = ~paste0("P-Value:", P.Ii)) %>%
addProviderTiles(
"Esri.WorldStreetMap",
group = "Esri.WorldStreetMap") %>%
addProviderTiles(
"Esri.WorldImagery",
group = "Esri.WorldImagery") %>%
addProviderTiles(
"Stamen.TonerHybrid",
group = "Stamen.TonerHybrid") %>%
addLayersControl(
baseGroups = c('Esri.WorldStreetMap', 'Esri.WorldImagery', 'Stamen.TonerHybrid') %>%
addLegend(pal = pal_lisa, values = ~lisa_cluster, title = 'LISA Quadrant'))
