group = "Stamen.TonerHybrid") %>%
# Polygons with improved popup
addPolygons(
group = "LISA Clusters",  # Added group name
fillColor = ~pal_lisa(lisa_cluster),
stroke = TRUE,
color = 'black',
fillOpacity = 0.8,
weight = 1,
popup = ~paste("County:", NAME, "<br>P-Value:", round(P.Ii, 4))
) %>%
# Legend with explicit positioning
addLegend(
position = "bottomright",
pal = pal_lisa,
values = ~lisa_cluster,
title = 'LISA Clusters',
opacity = 1
) %>%
# Layer control with all groups
addLayersControl(
baseGroups = c("OpenStreetMap", "Esri.WorldStreetMap",
"Esri.WorldImagery", "Stamen.TonerHybrid"),
options = layersControlOptions(collapsed = FALSE)
)
