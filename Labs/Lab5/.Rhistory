# Base tiles with explicit group name
addTiles(group = "OpenStreetMap") %>%
addProviderTiles(
"Esri.WorldStreetMap",
group = "Esri.WorldStreetMap") %>%
addProviderTiles(
"Esri.WorldImagery",
