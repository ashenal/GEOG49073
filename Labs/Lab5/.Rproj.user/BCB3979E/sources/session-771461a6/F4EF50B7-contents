### Task 1. From lab 2, task 2.3:

*Original task to be recreated using Leaflet:* Make a map of the counties, shading each county by the total cost of BMPs funded/implemented in that county. This will required you to join multiple datasets together

*Leaflet/other extras to add:*

- Mouse-over label the displays the total cost of BMPs funded in that county

- Use an equal-interval classification method with 5 classes. Determine the breaks programmatically.

- Do NOT use the default color scheme


```{r}

# Data Pull
counties <- sf::read_sf("./CBW/County_Boundaries.shp") %>% 
  sf::st_make_valid() %>% 
  st_transform(., "EPSG:4326")

bmps <- read_csv("./CBW/BMPreport2016_landbmps.csv")

# Find total cost per county in the BMPS table
bmps1 <- bmps %>%
  mutate(., FIPS.trimmed = stringr::str_sub(GeographyName, 1, 5)) %>% 
  group_by(FIPS.trimmed) %>% 
  summarize(Total_Cost = sum(Cost, na.rm = T))
  
# Join data to acquire the total cost column on the counties layer
County_BMP <- counties %>% 
  left_join(bmps1, by = c("GEOID10" = "FIPS.trimmed"))

# Make equal interval breaks and create color palette 
#(might be a different way to do this but I found the classInt package while searching for how to accomplish this task)
equal_interval <- classIntervals(County_BMP$Total_Cost, n = 5, style = "equal")$breaks
pal_equal <- colorBin("YlOrRd", domain = County_BMP$Total_Cost, bins = 5)

# Leaflet Map
Task_1 <- leaflet(County_BMP) %>%
  addTiles() %>%
  addPolygons(
    data = County_BMP,
    fillColor = ~pal_equal(Total_Cost),
    stroke = TRUE,
    color = 'black',
    fillOpacity = 1,
    weight = 2,
    popup = ~paste0("Total Cost: $", Total_Cost),
    label =  ~paste0("Total Cost: $", Total_Cost)) %>%
  addLegend(pal = pal_equal, values = ~Total_Cost, title = "Total Cost")

Task_1



```


### Task 2. From lab 3, task Bonus #2:

*Original task to be recreated using Leaflet:* plot a choropleth map of your dataset with a categorical color scheme, where the shading corresponds to the Moran plot (really, “LISA”) quadrants. Thus, your map will have four shades of color.

*Leaflet/other extras to add:*

- Add a pop-up window that displays the p-value (you'll have to look at the `moran.plot()` documentation) when you click on that county with a mouse

- Add a control to change between 3 different basemaps

```{r}
d.Midwest <- st_read("./data/d.Midwest")

# Pull in and GEOID needs fixed to match counties
d.x8 <- read_csv("./data/x08_Commuting.csv") %>% 
  mutate(fixed_geoid = str_sub(GEOID, start = 8, end = -1))

# Join data
JoinedData <- d.Midwest %>% left_join(., d.x8, by = c("GEOID" = "fixed_geoid"))

JoinedData <- JoinedData %>% 
  select(STATEFP, COUNTYF, GEOID, NAME, TOT_POP = B08006e1, Drove_Alone = B08006e20) %>%  # Select the needed columns
  mutate(PntPersonalCom = (Drove_Alone/TOT_POP)*100) %>%  # new column: % of people who commute with a personal vehicle
  st_transform(., "EPSG:4326")


# make the neighborhood
nb <- spdep::poly2nb(JoinedData, queen = TRUE)

# Assign weights using style W
lw <- nb2listw(nb, style="W", zero.policy=TRUE)


################
# I had a harder time with this part so if it looks weird it is because I got a lot of help from online forums and documentations
################

localmoran <-localmoran(JoinedData$PntPersonalCom, lw, zero.policy = TRUE)
Lag <- lag.listw(lw, JoinedData$PntPersonalCom, zero.policy = TRUE)

# Add the p value and lag info to the counties
JoinedData$P.Ii <- localmoran[, "Pr(z != E(Ii))"]
Lag <- JoinedData$PntPersonalCom_lag

# Standardize the variables - this is to make the next step easier. Scaling makes the means 0
JoinedData$PntPersonalCom_std <- scale(JoinedData$PntPersonalCom)
JoinedData$PntPersonalCom_lag_std <- scale(JoinedData$PntPersonalCom_lag)

# Classify observations into LISA clusters using the standardizing variables and the p value
JoinedData$lisa_cluster <- case_when(
  JoinedData$PntPersonalCom_std > 0 & 
    JoinedData$PntPersonalCom_lag_std > 0 & 
    JoinedData$P.Ii <= 0.05 ~ "High-High",
  
  JoinedData$PntPersonalCom_std < 0 & 
    JoinedData$PntPersonalCom_lag_std < 0 & 
    JoinedData$P.Ii <= 0.05 ~ "Low-Low",
  
  JoinedData$PntPersonalCom_std < 0 & 
    JoinedData$PntPersonalCom_lag_std > 0 & 
    JoinedData$P.Ii <= 0.05 ~ "Low-High",
  
  JoinedData$PntPersonalCom_std > 0 & 
    JoinedData$PntPersonalCom_lag_std < 0 & 
    JoinedData$P.Ii <= 0.05 ~ "High-Low",
  
  TRUE ~ "Not significant")

# make a color palette for the LISA values
pal <- c("High-High" = "red",
                 "Low-Low" = "blue",
                 "Low-High" = "lightblue",
                 "High-Low" = "pink",
                 "Not significant" = "white")

pal_lisa <- colorFactor(palette = pal, domain = JoinedData$lisa_cluster) 

# leaflet mapping
Task_2 <- leaflet(JoinedData) %>% 
  addTiles() %>% 
  addPolygons(
    data = JoinedData,
    fillColor = ~pal_lisa(lisa_cluster),
    stroke = TRUE,
    color = 'black',
    fillOpacity = 1,
    weight = 2,
    popup = ~paste0("P-Value:", P.Ii)) %>% 
   addProviderTiles(
    "Esri.WorldStreetMap",
    group = "Esri.WorldStreetMap") %>%
  addProviderTiles(
    "Esri.WorldImagery",
    group = "Esri.WorldImagery") %>%
  addProviderTiles(
    "Stamen.TonerHybrid",
    group = "Stamen.TonerHybrid") %>% 
  addLayersControl(baseGroups = c('Esri.WorldStreetMap', 'Esri.WorldImagery', 'Stamen.TonerHybrid')) %>% 
