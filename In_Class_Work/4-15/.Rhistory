fillOpacity = 1) %>%
addLayersControl(
overlayGroups = c("Monitoring Stations", "Removed Dams")
)
M
library(tidyverse)
library(terra)
library(sf)
library(leaflet) #new
library(leaflet.extras) #new
library(RColorBrewer)
dams_removed <- read_sf("./CBW/Dam_or_Other_Blockage_Removed_2012_2017.shp") %>%
st_transform(., "EPSG:4326")
MS <- read_sf("./CBW/Non-Tidal_Water_Quality_Monitoring_Stations_in_the_Chesapeake_Bay.shp") %>%
st_transform(., "EPSG:4326")
colors <- brewer.pal(6, "PuRd")
pal <- colorFactor(palette = colors, domain = dams_removed$DamRemoval)
M <- leaflet() %>%
addTiles() %>%
addCircleMarkers(
data = MS,
radius = ~log(Drainage_A),
fill = TRUE,
color = "blue",
fillColor = "blue") %>%
addCircleMarkers(
data = dams_removed,
radius = 4,
fill = TRUE,
color = ~pal(DamRemoval),
fillColor = ~pal(DamRemoval),
fillOpacity = 1) %>%
addLayersControl(
overlayGroups = c("Monitoring Stations", "Removed Dams")
)
M
?addLayersControl
M <- leaflet() %>%
addTiles() %>%
addCircleMarkers(
data = MS,
radius = ~log(Drainage_A),
fill = TRUE,
color = "blue",
fillColor = "blue",
group = 'Monitoring Stations') %>%
addCircleMarkers(
data = dams_removed,
radius = 4,
fill = TRUE,
color = ~pal(DamRemoval),
fillColor = ~pal(DamRemoval),
fillOpacity = 1,
group = 'Removed Dams') %>%
addLayersControl(
overlayGroups = c("Monitoring Stations", "Removed Dams")
)
M
M <- leaflet() %>%
addTiles() %>%
addCircleMarkers(
data = MS,
radius = ~log(Drainage_A),
fill = TRUE,
color = "blue",
fillColor = "blue",
group = 'Monitoring Stations') %>%
addCircleMarkers(
data = dams_removed,
radius = 4,
fill = TRUE,
color = ~pal(DamRemoval),
fillColor = ~pal(DamRemoval),
fillOpacity = 1,
group = 'Removed Dams') %>%
addProviderTiles(
"Esri.WorldStreetMap",
group = "Esri.WorldStreetMap") %>%
addProviderTiles(
"Esri.WorldImagery",
group = "Esri.WorldImagery") %>%
addLayersControl(
overlayGroups = c("Monitoring Stations", "Removed Dams"))
M <- leaflet() %>%
addTiles() %>%
addCircleMarkers(
data = MS,
radius = ~log(Drainage_A),
fill = TRUE,
color = "blue",
fillColor = "blue",
group = 'Monitoring Stations') %>%
addCircleMarkers(
data = dams_removed,
radius = 4,
fill = TRUE,
color = ~pal(DamRemoval),
fillColor = ~pal(DamRemoval),
fillOpacity = 1,
group = 'Removed Dams') %>%
addProviderTiles(
"Esri.WorldStreetMap",
group = "Esri.WorldStreetMap") %>%
addProviderTiles(
"Esri.WorldImagery",
group = "Esri.WorldImagery") %>%
addLayersControl(
overlayGroups = c("Monitoring Stations", "Removed Dams"),
baseGroups = c('Esri.WorldStreetMap', 'Esdri.WOrldImagery'))
M
M <- leaflet() %>%
addTiles() %>%
addCircleMarkers(
data = MS,
