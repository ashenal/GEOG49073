library(tidyverse)
library(terra)
library(tidyterra)
library(sf)
library(mapview) # likely new to you
neoh_lulc <- terra::rast("./data/ohio/neoh_nlcd.tif")
# summary
terra::summary(neoh_lulc)
# plot it
terra::plot(neoh_lulc)
mapview(neoh_lulc)
neoh_lulc %>% terra::aggregate(., 3, fun = "modal") %>% mapview(.)
# using terra vector classes to make later operations easier
# project to the crs of the raster so we don't need to resample raster (which takes forever)
neoh_counties <- vect("../data/ohio/neoh_counties.gpkg") %>%
terra::project(., crs(neoh_lulc))
# using terra vector classes to make later operations easier
# project to the crs of the raster so we don't need to resample raster (which takes forever)
neoh_counties <- vect("./data/ohio/neoh_counties.gpkg") %>%
terra::project(., crs(neoh_lulc))
oh_tracts <- vect("./data/ohio/oh_tracts_2020.gpkg") %>%
terra::project(., crs(neoh_lulc))
mapview(neoh_counties) + mapview(oh_tracts)
test <- terra::zonal(neoh_lulc, neoh_counties)
test
z.max <- terra::zonal(neoh_lulc, neoh_counties, fun = "max")
z.max
values <- extract(neoh_lulc, neoh_counties)
values
values %>% group_by(ID, `NLCD Land Cover Class`) %>%
summarise(ncells = n())
values$`NLCD Land Cover Class`
unique(values$`NLCD Land Cover Class`)
# starting with this object
df.cells <- values %>% group_by(ID, `NLCD Land Cover Class`) %>%
summarise(ncells = n())
df.cells %>%
dplyr::ungroup() %>% # Why do i need to ungroup?
dplyr::filter(`NLCD Land Cover Class` == "Barren Land") %>%
dplyr::slice_max(., ncells, n = 1)
df.forfract <- df.cells %>%
group_by(ID) %>%
mutate(tot_cells = sum(ncells)) %>%
dplyr::filter(., str_detect(`NLCD Land Cover Class`, "Forest")) %>%
group_by(ID) %>%
summarise(forest_cells = sum(ncells),
tot_cells = max(tot_cells)) %>%
mutate(frac_forest = forest_cells/tot_cells)
df.forfract
# make the data "wide"
df.cells.w <- df.cells %>% pivot_wider(id_cols = ID,
names_from = `NLCD Land Cover Class`,
values_from = ncells)
df.cells.w.calc <- df.cells.w %>%
mutate(., ) # <- what might go in here???
df.cells.w.calc
# get the vector data setup
neoh_counties.fix <- neoh_counties %>%
as_sf(.) %>% # don't need terra::vect anymore, so let's stop using it
tidyterra::mutate(., simpleid = seq(1:nrow(.)))
neoh_counties.fix
# put it together
d.joined <- neoh_counties.fix %>% left_join(., df.cells.w, by = c("simpleid" = "ID"))
# So, we could use a mutate() and calculate the fraction of forest here.
# Or we could reuse the data we made above
d.joined.for <- d.joined %>% left_join(df.forfract, by = c("simpleid" = "ID"))
d.joined.for
d.joined.for %>% mapview::mapView(zcol = "frac_forest")
mapView(terra::aggregate(neoh_lulc, 3, fun = "modal")) + mapView(d.joined.for, zcol = "frac_forest")
d.long <- d.joined.for %>%
st_drop_geometry() %>%
dplyr::select(-(LSAD:simpleid)) %>%
pivot_longer(., cols = Unclassified:frac_forest, names_to = "lulc", values_to = "value")
d.long
d.long %>%
ggplot(., aes(x = lulc, y = value)) +
geom_col() +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(x = "Land use type", y = "number of cells")
d.long %>%
dplyr::filter(., !lulc %in% c("forest_cells", "tot_cells")) %>%
ggplot(., aes(x = lulc, y = value, fill = NAME)) +
geom_col() +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(x = "Land use type", y = "number of cells")
cell.area <- terra::res(neoh_lulc)[1] * terra::res(neoh_lulc)[2]
d.long %>%
dplyr::filter(., !lulc %in% c("forest_cells", "tot_cells")) %>%
ggplot(., aes(x = lulc, y = value * cell.area, fill = NAME)) +
geom_col() +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(x = "Land use type", y = "Area (sq. meters)") +
facet_wrap(~NAME) +
#facet_grid(.~NAME) + # a messier alternative
theme(legend.position = "none")
library(tidyverse)
library(terra)
library(tidyterra)
library(sf)
library(mapview)
library(landscapemetrics) # new - you'll likely need to install this package
neoh_lulc <- terra::rast("./data/ohio/neoh_nlcd.tif")
# summary
terra::summary(neoh_lulc)
# using terra vector classes to make later operations easier
# project to the crs of the raster so we don't need to resample raster (which takes forever)
neoh_counties <- vect("./data/ohio/neoh_counties.gpkg") %>%
terra::project(., crs(neoh_lulc))
oh_tracts <- vect("./data/ohio/oh_tracts_2020.gpkg") %>%
terra::project(., crs(neoh_lulc))
mapview(oh_tracts)
portage <- neoh_counties %>% tidyterra::filter(NAME == "Portage")
summit <- neoh_counties %>% tidyterra::filter(NAME == "Summit")
# just for demonstration, some spatial sampling
port.samples <- terra::spatSample(portage, size = 40, method = "random")
port.buffs <- terra::buffer(port.samples, width = 400)
# map them together (hence the union function)
terra::union(portage, summit) %>%
mapview(., label = "NAME", zcol = "NAME") +
mapview(port.buffs) # add the buffers on top
# using terra vector classes to make later operations easier
# project to the crs of the raster so we don't need to resample raster (which takes forever)
neoh_counties <- vect("./data/ohio/neoh_counties.gpkg") %>%
terra::project(., crs(neoh_lulc))
oh_tracts <- vect("./data/ohio/oh_tracts_2020.gpkg") %>%
terra::project(., crs(neoh_lulc))
mapview(oh_tracts)
lulc.portage <- neoh_lulc %>% terra::crop(., portage)
mapview(portage) + mapview(lulc.portage)
masked.portage <- lulc.portage %>% terra::mask(., portage)
dim(lulc.portage)
dim(masked.portage)
lulc.portage %>% values() %>% as_tibble() %>%
dplyr::filter(is.na(`NLCD Land Cover Class`)) %>% nrow()
masked.portage %>% values() %>% as_tibble() %>%
dplyr::filter(is.na(`NLCD Land Cover Class`)) %>% nrow()
lulc.portage %>% values() %>% as_tibble() %>%
dplyr::filter(is.na(`NLCD Land Cover Class`)) %>% nrow()
masked.portage %>% values() %>% as_tibble() %>%
dplyr::filter(is.na(`NLCD Land Cover Class`)) %>% nrow()
# Patch density
## Landscape level
landscapemetrics::lsm_l_pd(lulc.portage)
## class level
landscapemetrics::lsm_c_pd(lulc.portage)
# Edge density
## landscape level
landscapemetrics::lsm_l_ed(lulc.portage)
## class level
landscapemetrics::lsm_c_ed(lulc.portage)
# Mean patch size
## Landscape level
landscapemetrics::lsm_l_area_mn(lulc.portage, directions = 8)
## Class level
landscapemetrics::lsm_c_area_mn(lulc.portage, directions = 8)
# Shannon's
landscapemetrics::lsm_l_shdi(lulc.portage)
# Simpson's
landscapemetrics::lsm_l_sidi(lulc.portage)
# Landscape shape index
landscapemetrics::lsm_l_lsi(lulc.portage)
landscapemetrics::lsm_c_lsi(lulc.portage)
# just those tracts
pc.tracts <- terra::intersect(oh_tracts, portage)
# map it to make sure we have what we want
pc.tracts %>% mapview()
# using terra vector classes to make later operations easier
# project to the crs of the raster so we don't need to resample raster (which takes forever)
neoh_counties <- vect("./data/ohio/neoh_counties.gpkg") %>%
terra::project(., crs(neoh_lulc))
oh_tracts <- vect("./oh_tracts_2020.gpkg") %>%
terra::project(., crs(neoh_lulc))
mapview(oh_tracts)
# just those tracts
pc.tracts <- terra::intersect(oh_tracts, portage)
# map it to make sure we have what we want
pc.tracts %>% mapview()
pc.tracts[1] %>% terra::crop(lulc.portage, .) %>%
landscapemetrics::lsm_l_shdi(.)
calc_shannon <- function(r, v){
toReturn <- terra::crop(r, v) %>%
landscapemetrics::lsm_l_shdi(.)
return(toReturn)
}
calc_shannon(lulc.portage, pc.tracts[1])
calc_shannon_wrapper <- function(i, r, tracts){
v <- tracts[i, ]
res <- calc_shannon(r, v)
res$seq_id <- i
return(res)
}
portage.results <- map_dfr(1:nrow(pc.tracts), calc_shannon_wrapper, r = lulc.portage, tracts = pc.tracts)
# Define a modified version of your function that works with one row of sf
calc_shannon_sf <- function(r, v_geom) {
v_vect <- terra::vect(v_geom)  # Convert sf geometry to SpatVector - WE DO HAVE TO CONVERT TO TERRA STILL
toReturn <- terra::crop(r, v_vect) %>%
landscapemetrics::lsm_l_shdi(.)
return(toReturn$value)
}
# Use rowwise mutate to apply to each feature
portage_tracts_sf <- pc.tracts %>%
as_sf() %>%
rowwise() %>%
mutate(shdi = calc_shannon_sf(lulc.portage, geometry)) %>%
ungroup()
portage_tracts_sf %>%
ggplot(., aes(x = shdi)) +
geom_histogram(bins = 25) +
theme_minimal()
sc.tracts <- terra::intersect(oh_tracts, summit)
lulc.sc <- neoh_lulc %>% terra::crop(., summit)
# map it to make sure we have what we want
mapview(lulc.sc) + mapview(sc.tracts)
summit_tracts_sf <- sc.tracts %>%
as_sf() %>%
rowwise() %>%
mutate(shdi = calc_shannon_sf(lulc.sc, geometry)) %>%
ungroup()
summit_tracts_sf %>%
ggplot(., aes(x = shdi)) +
geom_histogram(bins = 25) +
theme_minimal()
both_sf <- bind_rows(portage_tracts_sf, summit_tracts_sf)
mapview(both_sf, zcol = "shdi")
both_sf %>%
ggplot(., aes(x = shdi, fill = NAMELSAD.1)) +
geom_histogram() +
theme_minimal()
both_sf %>%
ggplot(., aes(x = shdi, fill = NAMELSAD.1)) +
geom_histogram() +
theme_minimal() +
theme(legend.position = "none") +
facet_grid(NAMELSAD.1~.)
both_sf %>%
ggplot(., aes(x = shdi, fill = NAMELSAD.1)) +
geom_density(alpha = 0.5) +
theme_minimal()
model <- aov(shdi ~ NAMELSAD.1, data = both_sf)
summary(model)
# Post hoc - not really necessary with only two groups, but useful if you have more than one
TukeyHSD(model)
Tracts_interest <- c('portage',
'summit',
'cuyahoga')
Multi.tracts <- terra::intersect(oh_tracts, Tracts_interest)
# Define a modified version of your function that works with one row of sf
calc_shannon_sf <- function(r, v_geom) {
v_vect <- terra::vect(v_geom)  # Convert sf geometry to SpatVector - WE DO HAVE TO CONVERT TO TERRA STILL
toReturn <- terra::crop(r, v_vect) %>%
landscapemetrics::lsm_l_shdi(.)
return(toReturn$value)
}
# Use rowwise mutate to apply to each feature
Multi_tracts_sf <- Multi.tracts %>%
as_sf() %>%
rowwise() %>%
mutate(shdi = calc_shannon_sf(lulc.portage, geometry)) %>%
ungroup()
?terra::intersect
Multi.tracts <- oh_tracts[oh_tracts$COUNTY %in% Tracts_interest, ]
# Define a modified version of your function that works with one row of sf
calc_shannon_sf <- function(r, v_geom) {
v_vect <- terra::vect(v_geom)  # Convert sf geometry to SpatVector - WE DO HAVE TO CONVERT TO TERRA STILL
toReturn <- terra::crop(r, v_vect) %>%
landscapemetrics::lsm_l_shdi(.)
return(toReturn$value)
}
# Use rowwise mutate to apply to each feature
Multi_tracts_sf <- Multi.tracts %>%
as_sf() %>%
rowwise() %>%
mutate(shdi = calc_shannon_sf(lulc.portage, geometry)) %>%
ungroup()
sc.tracts <- terra::intersect(oh_tracts, summit)
cy.tracts <- terra::intersect(oh_tracts, cuyahoga)
pc.tracts <- terra::intersect(oh_tracts, portage)
cy.tracts <- terra::intersect(oh_tracts, cuyahoga)
cy.tracts <- terra::intersect(oh_tracts, cuyahoga)
